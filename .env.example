APP_NAME="D-Library"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL, bukan SQLite. Skema, index, dan constraint di proyek ini
# ditulis untuk PostgreSQL, dan test suite tetap memakai SQLite in-memory
# (lihat phpunit.xml) -- jadi ikhtiarin yang membuat kedua sisi jalan.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=db_perpustakaan
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

PERPUSTAKAAN_LOAN_DURATION_DAYS=14
PERPUSTAKAAN_DISPLAY_TIMEZONE=Asia/Jakarta
PERPUSTAKAAN_REGISTRATION_ENABLED=true
PERPUSTAKAAN_COVER_DISK=public
PERPUSTAKAAN_BOOK_FILE_DISK=local
PERPUSTAKAAN_COVER_MAX_KB=2048
PERPUSTAKAAN_BOOK_FILE_MAX_KB=20480
PERPUSTAKAAN_PER_PAGE=12

# Batas rate limit. Semua nilai ini punya default di config/perpustakaan.php,
# jadi tidak wajib diisi -- tapi dituliskan supaya kelihatan mana angka yang
# sengaja bisa diubah, bukan sekadar angka yang muncul di kode.
PERPUSTAKAAN_LOGIN_MAX_ATTEMPTS=5
PERPUSTAKAAN_LOGIN_PER_MINUTE=10
PERPUSTAKAAN_REGISTER_PER_MINUTE=6
PERPUSTAKAAN_FILE_READ_PER_MINUTE=30
PERPUSTAKAAN_SEARCH_PER_MINUTE=60
